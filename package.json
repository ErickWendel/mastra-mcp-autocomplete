{
  "name": "mastra-mcp-autocomplete",
  "version": "1.0.0",
  "description": "Paste an event link: a Mastra agent browses it like a person through the Playwright MCP server and fills the talk form live",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "try": "node --env-file=.env scripts/try.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@mastra/core": "^1.79.0",
    "@mastra/mcp": "^2.5.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1"
  }
}
